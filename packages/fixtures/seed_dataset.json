{
  "_meta": {
    "description": "Comprehensive synthetic seed dataset for the Tencent Hackathon Enterprise AI Assistant. Designed to exercise all 5 demo scenarios (authorised query, restricted query, permission revocation, fresh-data update, audit lookup) and all P0 security invariants (cross-tenant isolation, denied-text-never-reaches-model, missing identity deny, provider timeout deny, revocation on next query, citation revocation, tenant ID injection, prompt injection, audit failure blocks answer, immutable audit row).",
    "spec_reference": "Section 51 — Synthetic Fixture Model",
    "encoding": "UTF-8",
    "notes": [
      "All timestamps are ISO 8601 UTC.",
      "Provider subject IDs are synthetic opaque strings, not emails.",
      "Encrypted fields are represented as placeholder base64 — real seeding encrypts at runtime.",
      "UUIDs are UUIDv7-style for sortability but synthetic."
    ]
  },

